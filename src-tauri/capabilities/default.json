{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:7644/*",
      "http://127.0.0.1:7644/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "allow-soundcloud-login"
  ]
}
