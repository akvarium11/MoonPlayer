{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MoonPlayer",
  "version": "2.5.0",
  "identifier": "com.moonplayer.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-node.js",
    "frontendDist": "../public",
    "devUrl": "http://localhost:7644"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server.js": "server/server.js",
      "../soundcloud_service.js": "server/soundcloud_service.js",
      "../discord_presence.js": "server/discord_presence.js",
      "../discord_config.json": "server/discord_config.json",
      "../package.json": "server/package.json",
      "../public": "server/public",
      "../assets": "server/assets",
      "../node_modules": "server/node_modules",
      "../bin/node.exe": "server/bin/node.exe"
    }
  }
}
